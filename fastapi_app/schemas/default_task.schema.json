{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DefaultTask",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 60,
      "description": "Kurzer Titel der Aufgabe"
    },
    "topic": {
      "type": "string",
      "description": "Thema oder Fachgebiet der Aufgabe"
    },
    "points_total": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "description": "Gesamtpunkte für die Aufgabe"
    },
    "task": {
      "type": "string",
      "description": "Die eigentliche Aufgabenstellung"
    }
  },
  "required": ["title", "topic", "points_total", "task"]
}
